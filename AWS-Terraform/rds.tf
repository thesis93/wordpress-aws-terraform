# ---------------------------------------------------------------------------
# Database password: generated by Terraform, passed to RDS and to the
# instance bootstrap. Not stored in SSM here (keeps the project free of any
# IAM/SSM permissions that AWS Academy Learner Lab may restrict). You can read
# it after apply with:  terraform output -raw db_password
# ---------------------------------------------------------------------------

resource "random_password" "db" {
  length  = 24
  special = true
  # Exclude characters that complicate shell/sed handling in user_data.
  override_special = "!#%*+-=?^_"
}

# ---------------------------------------------------------------------------
# RDS MySQL, Multi-AZ, in the private subnets only.
# ---------------------------------------------------------------------------

resource "aws_db_subnet_group" "wordpress" {
  name       = "${var.project_name}-db-subnet-group"
  subnet_ids = aws_subnet.private[*].id

  tags = {
    Name = "${var.project_name}-db-subnet-group"
  }
}

resource "aws_db_instance" "wordpress" {
  identifier     = "${var.project_name}-mysql"
  engine         = "mysql"
  engine_version = var.db_engine_version
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_allocated_storage * 5
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result
  port     = 3306

  multi_az               = true
  db_subnet_group_name   = aws_db_subnet_group.wordpress.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false

  backup_retention_period = 7
  skip_final_snapshot     = true  # set false + final_snapshot_identifier for production
  deletion_protection     = false # set true for production
  apply_immediately       = true

  tags = {
    Name = "${var.project_name}-mysql"
  }
}
